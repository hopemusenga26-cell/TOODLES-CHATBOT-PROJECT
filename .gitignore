# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets
.env

# Copyrighted books and everything derived from their full text.
# Share these only through the project's approved private storage.
data/books/*
!data/books/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
data/chats/

# Large model files. LoRA adapters are trained on book passages: share their weights
# privately; their adapter_config.json and training_record.json are committed.
artifacts/**/*.safetensors
artifacts/**/*.bin
artifacts/checkpoints/

# Evaluation review sheets quote book passages; share them privately.
evaluation/answers_for_review*.json
evaluation/human_review.xlsx

# Office lock files
~$*
